# Never commit your real .env. No credentials are sent to the browser.
GEMINI_API_KEY=
CASETRACE_PROVIDER=gemini
CASETRACE_MODEL=gemini-2.5-flash
# Optional OpenAI-compatible provider, e.g. Ollama:
# CASETRACE_PROVIDER=compatible
# CASETRACE_BASE_URL=http://127.0.0.1:11434/v1
# CASETRACE_MODEL=qwen3:8b
# CASETRACE_API_KEY=
# Retrieval: local uses explicit lexical feature vectors, not neural embeddings.
# gemini uses the Gemini embedding API; this sends document chunks to Google.
CASETRACE_EMBEDDINGS=local
CASETRACE_MAX_CALLS=8
CASETRACE_MAX_OUTPUT_TOKENS=3500
CASETRACE_DATA_DIR=data
